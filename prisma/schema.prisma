generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id
  username    String           @unique
  createdAt   DateTime         @default(now())
  session     WhatsAppSession?
  media       MediaAsset[]
  downloads   DownloadHistory[]
  activities  ActivityLog[]
  preferences UserPreferences?

  @@map("users")
}

model WhatsAppSession {
  id             String   @id @default(cuid())
  userId         String   @unique
  provider       String   @default("baileys")
  state          String   @default("disconnected")
  authStateCiphertext String? @db.Text
  connectedAt    DateTime?
  lastConnectedAt DateTime?
  lastErrorCode  String?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_sessions")
}

model MediaAsset {
  id          String           @id
  userId      String
  fileName    String
  mimeType    String
  mediaType   String
  byteSize    Int
  storageKey  String           @unique
  sha256      String?
  source      String           @default("manual-import")
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads   DownloadHistory[]

  @@index([userId, createdAt])
  @@map("media_assets")
}

model DownloadHistory {
  id          String     @id
  userId      String
  mediaId     String?
  fileName    String
  status      String
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  errorCode   String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@map("download_history")
}

model ActivityLog {
  id        String   @id
  userId    String
  type      String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_logs")
}

model UserPreferences {
  id           String   @id @default(cuid())
  userId       String   @unique
  retentionDays Int     @default(30)
  autoCleanup  Boolean  @default(true)
  libraryView  String   @default("grid")
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
