# Local-only admin account. Change both values before any deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=imhub-demo-2026
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -hex 32. Keep it unchanged to decrypt linked-device credentials.
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Local development can leave this blank (uses a single-instance JSON store in .data/).
# Production must set a Railway PostgreSQL URL and run Prisma migrations.
DATABASE_URL=

# File storage. Local dev uses .data/media. Production must use an S3-compatible bucket.
# Railway Object Storage / Cloudflare R2 / AWS S3 are supported.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# App settings
DATA_DIR=.data
MAX_UPLOAD_MB=100
APP_BASE_URL=
